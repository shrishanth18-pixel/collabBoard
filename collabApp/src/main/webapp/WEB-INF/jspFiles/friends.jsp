<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Connections - CollabBoard</title>
<style>body{margin:0;font-family:Segoe UI,Arial,sans-serif;background:#f4f6f9;color:#1f2937}.shell{max-width:800px;margin:40px auto;padding:24px}.card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:22px;margin-bottom:18px}.row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #eef1f5}.row:last-child{border-bottom:0}form{display:flex;gap:8px}input,button{padding:10px;border-radius:8px}input{flex:1;border:1px solid #d1d5db}button{border:0;background:#4f46e5;color:#fff;font-weight:700}a{color:#4f46e5;text-decoration:none}</style>
</head><body><main class="shell"><p><a href="${pageContext.request.contextPath}/dashboard">← Dashboard</a></p><h1>Connections</h1>
<section class="card"><h2>Add a friend</h2><form method="post" action="${pageContext.request.contextPath}/friends"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="send"><input name="username" placeholder="Exact username" required><button type="submit">Send request</button></form></section>
<section class="card"><h2>Pending requests</h2><c:choose><c:when test="${not empty pendingFriends}"><c:forEach var="friend" items="${pendingFriends}"><div class="row"><span>@<c:out value="${friend.username}"/></span><form method="post" action="${pageContext.request.contextPath}/friends"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="accept"><input type="hidden" name="friendshipId" value="${friend.friendshipId}"><button type="submit">Accept</button></form></div></c:forEach></c:when><c:otherwise><p>No pending requests.</p></c:otherwise></c:choose></section>
<section class="card"><h2>My connections</h2><c:choose><c:when test="${not empty friends}"><c:forEach var="friend" items="${friends}"><div class="row"><span>@<c:out value="${friend.username}"/></span></div></c:forEach></c:when><c:otherwise><p>No accepted connections yet.</p></c:otherwise></c:choose></section></main></body></html>
